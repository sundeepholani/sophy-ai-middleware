# ============================================================================
# AI Middleware — environment variables
# Copy to .env.local for local dev. In production set these in the Vercel
# project (Settings → Environment Variables) or via `vercel env`.
# ============================================================================

# --- Postgres (Supabase) ---------------------------------------------------
# The Vercel↔Supabase Marketplace integration sets POSTGRES_URL /
# POSTGRES_URL_NON_POOLING automatically — if you use it, you can leave the two
# vars below unset. For a manual setup, copy from Supabase → Project Settings →
# Database → Connection string:
#
# Pooled (Supavisor transaction mode, port 6543) — used by the running app:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# Direct connection (port 5432) — used ONLY for migrations (drizzle-kit):
DATABASE_URL_UNPOOLED="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require"
# If you hit "self-signed certificate in certificate chain", set this to 1:
# DATABASE_SSL_NO_VERIFY="1"

# (Rate limiting, quota, and the cron lock run on Postgres — no Redis needed.)

# --- Vercel AI Gateway -----------------------------------------------------
# Each Sophy project stores its own Admin-supplied Vercel AI Gateway API key,
# encrypted with the secrets below. Tenant traffic never falls back to this
# deployment variable or to Vercel OIDC.
#
# Cloudflare Workers AI (Clef, Clairic) has no deployment variable at all: each
# project's Admin connects that project's own Cloudflare account ID and API
# token, encrypted with the same secrets. Sophy never calls Workers AI with a
# platform credential, so do not add a CLOUDFLARE_* variable here.
#
# Migration only: when an existing single-tenant installation is converted, its
# backfilled project initially has a tightly scoped platform_env credential row
# so existing Sophy keys do not go down during the cutover. Set this until that
# project's Admin connects its dedicated project key, then remove it. New
# projects can never select this source.
AI_GATEWAY_API_KEY=""

# --- Vercel Blob (large client file uploads) -------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Secrets ---------------------------------------------------------------
# HMAC pepper for hashing issued client API keys at rest (random 32+ bytes).
#   openssl rand -hex 32
KEY_HASH_PEPPER=""
# Browser session password and keyed email-OTP hash secret, >= 32 chars.
#   openssl rand -hex 32
SESSION_PASSWORD=""
# AES-256-GCM key used only to encrypt project provider credentials: Vercel AI
# Gateway keys and Cloudflare Workers AI API tokens, each bound to its own
# authenticated-data domain. Supply either 32 random bytes as base64 or 64
# hexadecimal characters.
#   openssl rand -base64 32
PROJECT_GATEWAY_ENCRYPTION_KEY=""
# Version label authenticated with every encrypted credential. Change only as
# part of an explicit re-encryption/key-rotation procedure.
PROJECT_GATEWAY_ENCRYPTION_KEY_VERSION="v1"
# Separate 32+ byte HMAC key for duplicate-secret fingerprints of both credential
# types (domain-separated). Do not reuse the encryption key, KEY_HASH_PEPPER, or
# SESSION_PASSWORD. Treat this as immutable after first use; rotation requires
# re-fingerprinting every active credential of both types.
#   openssl rand -hex 32
PROJECT_GATEWAY_FINGERPRINT_KEY=""
# Canonical origin for invitation URLs, e.g. https://sophy.in. Set this explicitly
# in production unless VERCEL_PROJECT_PRODUCTION_URL is available. Link origins
# never come from request Host headers (which are spoofable). Local development
# falls back to the dev origin, so this can remain blank locally.
APP_ORIGIN=""
# Shared secret guarding the cron endpoint (Vercel sends it as a Bearer token).
#   openssl rand -hex 32
CRON_SECRET=""

# --- Sign-in codes, invitations, and evaluation email (Amazon SES) ----------
# Required for email sign-in and invitations. The evaluation recipient is
# configured in project settings.
# Region of the SES verified sender and account (e.g. ap-south-1).
SOPHY_SES_REGION=""
# Verified SES address (e.g. notifications@sophy.in).
SOPHY_SES_FROM=""
# IAM role trusted by Vercel OIDC. Local runs without this use the AWS SDK's
# standard credential chain.
SOPHY_SES_ROLE_ARN=""
# All local and preview email goes here. Leave blank to disable non-production
# email. Use this address when testing sign-in or accepting an invitation.
SOPHY_MAIL_TEST_TO=""

# --- Misc ------------------------------------------------------------------
# Segment used in issued keys: mw_<live|test>_xxxxxxxx
MIDDLEWARE_KEY_ENV="live"
