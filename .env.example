# ============================================================================
# AI Middleware — environment variables
# Copy to .env.local for local dev. In production set these in the Vercel
# project (Settings → Environment Variables) or via `vercel env`.
# ============================================================================

# --- Postgres (Supabase) ---------------------------------------------------
# The Vercel↔Supabase Marketplace integration sets POSTGRES_URL /
# POSTGRES_URL_NON_POOLING automatically — if you use it, you can leave the two
# vars below unset. For a manual setup, copy from Supabase → Project Settings →
# Database → Connection string:
#
# Pooled (Supavisor transaction mode, port 6543) — used by the running app:
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# Direct connection (port 5432) — used ONLY for migrations (drizzle-kit):
DATABASE_URL_UNPOOLED="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require"
# If you hit "self-signed certificate in certificate chain", set this to 1:
# DATABASE_SSL_NO_VERIFY="0"

# --- Upstash Redis (via Vercel Marketplace) --------------------------------
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# --- Vercel AI Gateway -----------------------------------------------------
# Locally, set an API key (Vercel dashboard → AI Gateway → API Keys).
# In production on Vercel, OIDC (VERCEL_OIDC_TOKEN) is used automatically and
# this can be omitted. Provider keys (OpenAI/Anthropic) are configured as BYOK
# inside the AI Gateway dashboard — NOT here.
AI_GATEWAY_API_KEY=""

# --- Vercel Blob (large client file uploads) -------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Secrets ---------------------------------------------------------------
# HMAC pepper for hashing issued client API keys at rest (random 32+ bytes).
#   openssl rand -hex 32
KEY_HASH_PEPPER=""
# iron-session cookie password, >= 32 chars.
#   openssl rand -hex 32
SESSION_PASSWORD=""
# bcrypt hash of the single admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'your-password'
ADMIN_PASSWORD_HASH=""
ADMIN_USERNAME="admin"
# Shared secret guarding the cron endpoint (Vercel sends it as a Bearer token).
#   openssl rand -hex 32
CRON_SECRET=""

# --- Misc ------------------------------------------------------------------
# Segment used in issued keys: mw_<live|test>_xxxxxxxx
MIDDLEWARE_KEY_ENV="live"
