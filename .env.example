# ============================================================================
# AI Middleware — environment variables
# Copy to .env.local for local dev. In production set these in the Vercel
# project (Settings → Environment Variables) or via `vercel env`.
# ============================================================================

# --- Azure Database for PostgreSQL ----------------------------------------
# Use the dedicated PostgreSQL 17 Flexible Server. The application uses the
# built-in PgBouncer endpoint. Drizzle migrations use the direct endpoint.
DATABASE_URL="postgresql://sophy_app:<password>@<server>.postgres.database.azure.com:6432/sophy?sslmode=verify-full"
# Protected migration host only. Do not add this owner-capable URL to Vercel.
DATABASE_URL_UNPOOLED="postgresql://sophy_migrator:<password>@<server>.postgres.database.azure.com:5432/sophy?sslmode=verify-full"
# Fail closed if a stale secret points to the old database provider.
DATABASE_EXPECTED_HOST_SUFFIX=".postgres.database.azure.com"
# Maximum connections from each Vercel function instance.
DATABASE_POOL_MAX="5"
# Local diagnostics only. Production rejects disabled certificate checks.
# DATABASE_SSL_NO_VERIFY="1"

# Rate limiting, quota, and the cron lock use PostgreSQL. Redis is not required.

# --- Vercel AI Gateway -----------------------------------------------------
# Each Sophy project stores its own Admin-supplied Vercel AI Gateway API key,
# encrypted with the secrets below. Tenant traffic never falls back to this
# deployment variable or to Vercel OIDC.
#
# Migration only: when an existing single-tenant installation is converted, its
# backfilled project initially has a tightly scoped platform_env credential row
# so existing Sophy keys do not go down during the cutover. Set this until that
# project's Admin connects its dedicated project key, then remove it. New
# projects can never select this source.
AI_GATEWAY_API_KEY=""

# --- Vercel Blob (large client file uploads) -------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Secrets ---------------------------------------------------------------
# HMAC pepper for hashing issued client API keys at rest (random 32+ bytes).
#   openssl rand -hex 32
KEY_HASH_PEPPER=""
# iron-session cookie password, >= 32 chars.
#   openssl rand -hex 32
SESSION_PASSWORD=""
# AES-256-GCM key used only to encrypt project Gateway credentials. Supply either
# 32 random bytes as base64 or 64 hexadecimal characters.
#   openssl rand -base64 32
PROJECT_GATEWAY_ENCRYPTION_KEY=""
# Version label authenticated with every encrypted credential. Change only as
# part of an explicit re-encryption/key-rotation procedure.
PROJECT_GATEWAY_ENCRYPTION_KEY_VERSION="v1"
# Separate 32+ byte HMAC key for duplicate-secret fingerprints. Do not reuse the
# encryption key, KEY_HASH_PEPPER, or SESSION_PASSWORD. Treat this as immutable
# after first use; rotation requires re-fingerprinting every active credential.
#   openssl rand -hex 32
PROJECT_GATEWAY_FINGERPRINT_KEY=""
# Canonical origin for magic-link URLs, e.g. https://sophy.in. Set this explicitly
# in production unless VERCEL_PROJECT_PRODUCTION_URL is available. Link origins
# never come from request Host headers (which are spoofable). Local development
# falls back to the dev origin, so this can remain blank locally.
APP_ORIGIN=""
# Shared secret guarding the cron endpoint (Vercel sends it as a Bearer token).
#   openssl rand -hex 32
CRON_SECRET=""

# --- Eval summary email (ZeptoMail) ----------------------------------------
# Sends the champion/challenger eval verdict when a run completes. Email is
# skipped (no-op) when either is unset. The "to" recipient is configured in the
# Project settings page (notify email), not here.
# ZeptoMail Send Mail token (the "Zoho-enczapikey ..." value, without the prefix).
ZEPTOMAIL_TOKEN=""
# A verified sender address in your ZeptoMail account, e.g. notifications@sophy.in
ZEPTOMAIL_FROM=""
# API host for your account's data center (default is the US one). India accounts
# MUST use the .in host or sends fail; EU uses .eu.
#   US:    https://api.zeptomail.com/v1.1/email   (default)
#   India: https://api.zeptomail.in/v1.1/email
#   EU:    https://api.zeptomail.eu/v1.1/email
ZEPTOMAIL_ENDPOINT=""

# --- Misc ------------------------------------------------------------------
# Segment used in issued keys: mw_<live|test>_xxxxxxxx
MIDDLEWARE_KEY_ENV="live"
